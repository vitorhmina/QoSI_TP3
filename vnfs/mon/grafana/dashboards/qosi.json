{
 "title": "QoSI - VNF chain",
 "uid": "qosi-chain",
 "description": "QoS VNF chain: access control, classification, policing/scheduling and monitoring.",
 "tags": [
  "qosi",
  "qos",
  "vnf"
 ],
 "schemaVersion": 39,
 "refresh": "2s",
 "time": {
  "from": "now-10m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Overview",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "VNF status",
   "description": "Each VNF exports metrics only while it is on: OFF means the VNF is off or the CORE session is not running.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "OFF",
         "color": "red"
        },
        "1": {
         "text": "ON",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=\"qosi\"}",
     "legendFormat": "{{vnf}}"
    }
   ],
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Classifier mode",
   "description": "rules, ml or collect (switched live with vnf.py mode).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "qosi_cls_mode == 1",
     "legendFormat": "{{mode}}"
    }
   ],
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "name"
   }
  },
  {
   "id": 4,
